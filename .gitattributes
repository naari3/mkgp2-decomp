# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files
*.py   text

# Enforce platform-specific encodings
*.bat  text eol=crlf
*.sh   text eol=lf
*.sha1 text eol=lf

# decomp-toolkit writes files with LF
config/**/*.txt  text eol=lf
# Append-only logs written by parallel threads: keep both sides on merge/rebase.
docs/sweeps/**/*.jsonl merge=union
tools/patterns/hits.jsonl merge=union
tools/patterns/nearmiss_history.jsonl merge=union
