        memset(first, 0, 12); \
        strcpy(first, parts[{{c: i | i | i | i | j | j | j | k | k | k}}]); \
        DebugPrintf(lbl_806D4750, first); \
        CP_WORD({{c: word | j | word | k | word | i | word | word | word | i}}, first); \
        for ({{c: k | k | j | j | k | k | i | i | j | j}} = {{c: i | i | i | i | j | j | j | k | k | k}} + 1; {{c: k | k | j | j | k | k | i | i | j | j}} < 5; {{c: k | k | j | j | k | k | i | i | j | j}}++) { \
