diff --git a/include/compiler/MwTrace.h b/include/compiler/MwTrace.h
new file mode 100644
index 0000000..6e554d6
--- /dev/null
+++ b/include/compiler/MwTrace.h
@@ -0,0 +1,84 @@
+/* Decision trace for the native mweppc build (tools/install_mweppc.sh --build).
+ * Not part of upstream mweppc; tools/mweppc_trace/trace.patch adds the calls.
+ * MWCC_TRACE=<file> appends one line per decision; MWCC_TRACE_FN=<linkname>
+ * limits it to one function. Output-neutral: it only writes the trace file. */
+#ifndef MWTRACE_H
+#define MWTRACE_H
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+extern char* mwtrace_fn;
+
+static FILE* mwtrace_out(void) {
+    static int init;
+    static FILE* f;
+    const char* want;
+    if (!init) {
+        const char* p = getenv("MWCC_TRACE");
+        init = 1;
+        if (p && *p) {
+            f = fopen(p, "a");
+        }
+    }
+    if (!f || !mwtrace_fn) {
+        return NULL;
+    }
+    want = getenv("MWCC_TRACE_FN");
+    if (want && *want && strcmp(want, mwtrace_fn) != 0) {
+        return NULL;
+    }
+    return f;
+}
+
+#define MWTRACE(...)                              \
+    do {                                          \
+        FILE* mwtrace_f_ = mwtrace_out();         \
+        if (mwtrace_f_) {                         \
+            fprintf(mwtrace_f_, __VA_ARGS__);     \
+            fflush(mwtrace_f_);                   \
+        }                                         \
+    } while (0)
+
+
+#include "compiler/PCode.h"
+#include "compiler/PCodeInfo.h"
+#include "compiler/objects.h"
+
+/* "op a,b,c": registers as r/f/v/c<num> (+ "!" when written), immediates,
+   memory offsets with their object, labels as L. */
+static void mwtrace_insn(FILE* f, PCode* pc) {
+    int i;
+    fprintf(f, "%s", opcodeinfo[pc->op].name);
+    for (i = 0; i < pc->argCount; i++) {
+        PCodeArg* a = &pc->args[i];
+        fputc(i ? ',' : ' ', f);
+        switch (a->kind) {
+            case PCOp_REGISTER:
+                fprintf(f, "%c%d%s",
+                    a->arg == RegClass_GPR ? 'r' : a->arg == RegClass_FPR ? 'f' : a->arg == RegClass_CRFIELD ? 'c' : 's',
+                    a->data.reg.reg, (a->data.reg.effect & EffectWrite) ? "!" : "");
+                break;
+            case PCOp_IMMEDIATE:
+                fprintf(f, "%ld", (long)a->data.imm.value);
+                if (a->data.imm.obj && a->data.imm.obj->name) {
+                    fprintf(f, "(%s)", a->data.imm.obj->name->name);
+                }
+                break;
+            case PCOp_MEMORY:
+                fprintf(f, "%ld", (long)a->data.mem.offset);
+                if (a->data.mem.obj && a->data.mem.obj->name) {
+                    fprintf(f, "(%s)", a->data.mem.obj->name->name);
+                }
+                break;
+            case PCOp_LABEL:
+                fprintf(f, "L");
+                break;
+            default:
+                fprintf(f, "_");
+                break;
+        }
+    }
+}
+
+#endif
