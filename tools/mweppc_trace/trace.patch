+static DGNode** mwtrace_nodes;
+static int mwtrace_nnodes;
+static int mwtrace_node_index(DGNode* n) {
+    int i;
+    for (i = 0; i < mwtrace_nnodes; i++) {
+        if (mwtrace_nodes[i] == n) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+static int mwtrace_resched(int index) {
+    const char* e = getenv("MWCC_TRACE_RESCHED");
+    if (!e || !*e) {
+        return 0;
+    }
+    if (!strcmp(e, "all")) {
+        return 1;
+    }
+    while (*e) {
+        if (atoi(e) == index) {
+            return 1;
+        }
+        while (*e && *e != ',') {
+            e++;
+        }
+        if (*e == ',') {
+            e++;
+        }
+    }
+    return 0;
+}
