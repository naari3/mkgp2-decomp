+#pragma cplusplus on
+struct ImpVec {
+    float x, y, z;
+    ImpVec() {}
+    ImpVec(float px, float py, float pz) : x(px), y(py), z(pz) {}
+    ~ImpVec() {}
+};
+
+struct ImpMtx {
+    float m[16];
+};
+
+static inline float Imp_sqrtf(float x) {
+    volatile float y;
+    if (x > lbl_806D26EC) {
+        double guess = __frsqrte(x);
+        guess = lbl_806D2720 * guess * (lbl_806D2728 - x * (guess * guess));
+        guess = lbl_806D2720 * guess * (lbl_806D2728 - x * (guess * guess));
+        guess = lbl_806D2720 * guess * (lbl_806D2728 - x * (guess * guess));
+        y = (float)(x * guess);
+        return y;
+    }
+    return x;
+}
+
+static inline void Imp_AddClamped(KartMovementSpeedView *mv, const ImpVec &v) {
+    mv->impact1ac += v.x;
+    mv->impact1b0 += v.y;
+    mv->impact1b4 += v.z;
+    float len = Imp_sqrtf(mv->impact1ac * mv->impact1ac + mv->impact1b0 * mv->impact1b0 + mv->impact1b4 * mv->impact1b4);
+    if (len > mv->impactCap1b8) {
+        float k = mv->impactCap1b8 / len;
+        mv->impact1ac *= k;
+        mv->impact1b0 *= k;
+        mv->impact1b4 *= k;
+    }
+}
+
+static inline unsigned char Imp_HasFlag(KartItemOpsView *self) {
+    if (self->ownerDriver->itemBus->flags & 0x10000000ULL) return 1;
+    return 0;
+}
+
+extern "C" void KartItem_ApplyImpactImpulseAndRumble(KartItemOpsView *self, int mode, float x, float y, float z) {
+    ImpMtx mtx;
+    for (int i = 0; i < 16; i++) mtx.m[i] = self->movement->transform[i];
+    ImpVec d(x - mtx.m[12], y - mtx.m[13], z - mtx.m[14]);
+    float len = Imp_sqrtf(d.x * d.x + d.y * d.y + d.z * d.z);
+    float k;
+
+    if (!EffectState_HasContent(self->effectState44)) {
+        float dot = d.x * mtx.m[0] + d.y * mtx.m[1] + d.z * mtx.m[2];
+        if (self->strPcbGate20 == 1) {
+            StrPcb_SetTimer3c40(StrPcb_GetInstance(), dot > lbl_806D26EC ? lbl_806D2734 : lbl_806D2738, 0xc);
+        }
+    }
+    float inv = -(lbl_806D26FC / len);
+    d.x *= inv;
+    d.y *= inv;
+    d.z *= inv;
+    if (!(self->ownerDriver->itemBus->flags & 0x10000000ULL) || !(unsigned char)mode) {
+        float s = lbl_806D273C * len;
+        d.x *= s;
+        d.y *= s;
+        d.z *= s;
+        Imp_AddClamped(self->movement, d);
+        len = lbl_806D2740 - len;
+        if (len < lbl_806D26EC) len = 1.0f;
+        len *= lbl_806D273C;
+    } else if (Imp_HasFlag(self) == 1) {
+        len = lbl_806D2740 - len;
+        if (len < lbl_806D26EC) len = 1.0f;
+        len *= lbl_806D273C;
+    }
+    float px = mtx.m[8] * d.x;
+    float py = mtx.m[9] * d.y;
+    float pz = mtx.m[10] * d.z;
+    float proj = -(px + py + pz);
+    ImpVec r(d.x * len, d.y * len, d.z * len);
+    self->movement->rumbleX310 = r.x;
+    self->movement->rumbleY314 = r.y;
+    self->movement->rumbleZ318 = r.z;
+    k = lbl_806D2744 * proj;
+    ImpVec w(mtx.m[8], mtx.m[9], mtx.m[10]);
+    w.x *= k;
+    w.y *= k;
+    w.z *= k;
+    d.x += w.x;
+    d.y += w.y;
+    d.z += w.z;
