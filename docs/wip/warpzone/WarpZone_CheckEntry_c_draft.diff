+static inline int FindOBB(WarpDashMgr *mgr, float x, float y, float z) {
+    if (!mgr->enabled) {
+        return -1;
+    }
+    if (mgr->obbCount <= 0) {
+        return -1;
+    }
+    WarpVec p(x, y, z);
+    for (int i = 0; i < mgr->obbCount; i++) {
+        if (WarpZone_Contains(mgr->obbs[i], p) == true) return i;
+    }
+    return -1;
 }
+extern "C" unsigned char WarpZone_CheckEntry(WarpAutoRun *self, float x, float y, float z) {
