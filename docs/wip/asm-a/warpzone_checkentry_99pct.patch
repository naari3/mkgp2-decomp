+static inline int WarpZone_FindContainingOBB_Inline(WarpDashMgr *mgr, float x, float y, float z) {
+    if (!mgr->enabled) {
+        return -1;
+    }
+    if (mgr->obbCount <= 0) {
+        return -1;
+    }
+    WarpVec p(x, y, z);
+    for (int i = 0; i < mgr->obbCount; i++) {
+        if (WarpZone_Contains(*(WarpZone *)((char *)mgr->obbs + i * sizeof(WarpZone)), p) == true) {
+            return i;
+        }
+    }
+    return -1;
+}
